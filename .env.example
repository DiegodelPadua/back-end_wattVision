# Configuração do servidor
PORT=3000

# Configuração do MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=coloque-a-senha-local-do-mysql
DB_NAME=watt_vision

# ==========================================
# CONFIGURAÇÃO MQTT
# ==========================================

MQTT_BROKER_URL=mqtt://SEU_BROKER:1883
MQTT_TOPIC_MEDICOES=wattvision/medicoes

# Autenticação JWT (use uma chave aleatória com pelo menos 32 caracteres)
JWT_SECRET=gere-uma-chave-segura-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h
DEMO_MODE=false
